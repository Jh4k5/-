# Bridge to China Edu — environment template
#
# Copy to .env.local (or .env) and fill in your project's values.
# The app also ships safe built-in fallbacks (src/lib/supabase/config.ts),
# so the site renders even when this file is absent — RLS keeps the
# publishable key safe to expose to the browser.

# Supabase project (Dashboard → Project Settings → API).
# The ANON key is the publishable one — NOT the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Canonical production origin used for canonical URLs, hreflang, JSON-LD,
# robots.txt and sitemap.xml. Overrides the `site_url` admin setting.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Local Prisma-style database file (scaffold only — the platform's database
# is Supabase; this variable is unused by the site).
DATABASE_URL=file:./db/custom.db
