# Bridge to China Edu — environment template
#
# Copy to .env.local (or .env) and fill in your project's values.
# The app also ships safe built-in fallbacks (src/lib/supabase/config.ts),
# so the site renders even when this file is absent — RLS keeps the
# publishable key safe to expose to the browser.

# Supabase project (Dashboard → Project Settings → API).
# The ANON key is the publishable one — NOT the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Canonical production origin used for canonical URLs, hreflang, JSON-LD,
# robots.txt and sitemap.xml. Overrides the `site_url` admin setting.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Local Prisma-style database file (scaffold only — the platform's database
# is Supabase; this variable is unused by the site).
DATABASE_URL=file:./db/custom.db

# ── Phase 4 · lead email notifications (Resend) ─────────────────────────
# All three are optional: without RESEND_API_KEY the site works normally,
# leads are still saved, and both emails are simply recorded as "skipped".
#
# RESEND_API_KEY         Restricted, sending-only key from resend.com/api-keys
#                       (never the account-wide key; never in client code).
# LEAD_NOTIFICATION_TO   The owner's address that receives
#                       "New Student Inquiry — Bridge to China Edu".
#                       Provided by the owner via a secure channel — do not
#                       commit the real value to this public repository.
# LEAD_NOTIFICATION_FROM Verified sender, e.g. notify@your-verified-domain.com.
#                       Defaults to Resend's shared test sender
#                       (onboarding@resend.dev), which can only deliver to
#                       the Resend account owner's own address — enough to
#                       test the owner notification during activation.
RESEND_API_KEY=
LEAD_NOTIFICATION_TO=
LEAD_NOTIFICATION_FROM=
